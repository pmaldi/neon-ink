{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeonInk",
  "mainBinaryName": "NeonInk",
  "version": "../package.json",
  "identifier": "com.patrice.neonink",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "NeonInk",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "publisher": "Patrice Maldi",
    "copyright": "© 2026 Patrice Maldi",
    "category": "Productivity",
    "shortDescription": "Dessin néon à l'écran",
    "longDescription": "Dessinez, annotez et numérotez des étapes par-dessus n'importe quelle application, avec un rendu néon. F10 active le dessin.",
    "homepage": "https://github.com/pmaldi/neon-ink"
  }
}
